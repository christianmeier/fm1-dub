# the Form page's middle: ALGORITHM goes ripples, scope, spectrum (1.4.0: then the prototypes, the echo trail, the
# fifths, the tape), ripples; it is said, and kept by SAVE
wait 4000
listen
shot ripples.png
turn ALGO 1
wait 1500
expect view 0
expect screen 1
said SCREEN SCOPE
shot scope.png
turn ALGO 1
wait 1500
expect screen 2
said SCREEN SPECTRUM
shot spectrum.png
# HOME from another page comes back to the Form page, as it was
tap ENV
wait 200
tap HOME
wait 200
expect view 0
expect screen 2
press GLO
wait 600
release GLO
reboot
wait 1500
expect screen 2
turn ALGO 1
wait 1500
expect screen 3
said SCREEN ECHO TRAIL
shot echo-trail.png
turn ALGO 1
wait 1500
expect screen 4
said SCREEN FIFTHS
shot fifths.png
turn ALGO 1
wait 1500
expect screen 5
said SCREEN TAPE
shot tape.png
turn ALGO 1
wait 200
expect screen 0
turn ALGO -1
wait 200
expect screen 5
turn ALGO 1
wait 200
expect screen 0
# HOME again: the Song page (1.4.0), again the Key page (the tempo, the root, the mode, swing), and again: back to Form
tap HOME
wait 200
expect view 27
said Song page, Endless: Intro 32 bars, Main 160 bars, Outro 32 bars, Kind Pulse
tap HOME
wait 200
expect view 18
said Key page: Tempo 122, Root F, Mode Dorian, Swing
tap HOME
wait 200
expect view 0
# each piece its own view: Basic on the spectrum, Chamber on the scope, kept through a change of piece and a reboot
turn ALGO 2
wait 200
expect screen 2
turn PRESET 1
wait 300
expect piece 1
expect screen 0
turn ALGO 1
wait 200
expect screen 1
turn PRESET -1
wait 300
expect piece 0
expect screen 2
turn PRESET 1
wait 300
expect screen 1
press GLO
wait 600
release GLO
reboot
wait 1500
expect piece 1
expect screen 1
turn PRESET -1
wait 300
expect screen 2
